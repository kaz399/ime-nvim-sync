# Transport keys emitted by xremap/Karabiner inside kitty:
#   Shift+F7  -> legacy kitty encoding: ESC [ 18 ; 2 ~
#   Shift+F12 -> legacy kitty encoding: ESC [ 24 ; 2 ~
#
# Neovim may canonicalize these as F19/F24.  At an ordinary interactive bash
# prompt, make Readline swallow the transport sequences so Shift+Space only
# appears to toggle the IME.

# Shift+F7
bind -m emacs-standard '"\e[18;2~":""'
bind -m vi-insertion    '"\e[18;2~":""'
bind -m vi-command      '"\e[18;2~":""'

# Shift+F12
bind -m emacs-standard '"\e[24;2~":""'
bind -m vi-insertion    '"\e[24;2~":""'
bind -m vi-command      '"\e[24;2~":""'

# Fallbacks for CSI-u F19/F24 representations (harmless if never generated).
bind -m emacs-standard '"\e[57382u":""'
bind -m vi-insertion    '"\e[57382u":""'
bind -m vi-command      '"\e[57382u":""'

bind -m emacs-standard '"\e[57387u":""'
bind -m vi-insertion    '"\e[57387u":""'
bind -m vi-command      '"\e[57387u":""'
